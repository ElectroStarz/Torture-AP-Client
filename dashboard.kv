# --- Presets / Custom Widgets ---
<Heading@Label>:
    font_size: '22sp'
    bold: True
    color: 1, 1, 1, 1
    size_hint_y: None
    height: '40dp'
    halign: 'center'
    valign: 'top'
    text_size: self.size

<TortureDashboard>:
    # Main container is vertical to hold the heading at the top
    orientation: 'vertical'
    padding: 10
    spacing: 10

    Heading:
        text: "Torture Dashboard"

    BoxLayout:
        orientation: 'horizontal'
        spacing: 20  # Space between the left and right columns

        # --- LEFT COLUMN ---
        BoxLayout:
            orientation: 'vertical'
            spacing: 10

            Label:
                text: "Multiworld Information"
                font_size: '16sp'
                bold: True
                color: 0.7, 0.7, 0.9, 1
                size_hint_y: None
                height: '30dp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Label:
                text: "Room Information\n\n" + root.room_info
                font_size: '16sp'
                text_size: self.size
                halign: 'left'
                valign: 'top'
                size_hint_y: None
                height: '120dp'

            Label:
                text: "Player Information\n\n" + root.player_info
                font_size: '16sp'
                text_size: self.size
                halign: 'left'
                valign: 'top'
                size_hint_y: None
                height: '120dp'

            Widget:
                # Pushes everything in the left column to the top

        # --- RIGHT COLUMN ---
        BoxLayout:
            orientation: 'vertical'
            spacing: 10

            # This empty widget acts as an invisible block to push the inputs
            # down slightly so they align with "Room Information" instead of
            # the "Multiworld Information" header.
            Widget:
                size_hint_y: None
                height: '30dp'

            TextInput:
                id: deathlink_reason
                multiline: True
                size_hint_y: None
                height: '40dp'
                hint_text: "Type a deathlink reason!"

            Button:
                text: "Send Deathlink"
                size_hint_y: None
                height: '40dp'
                on_release: root.send_deathlink(deathlink_reason.text)

            TextInput:
                id: trap_send_amount
                size_hint_y: None
                height: '40dp'
                hint_text: "No. of people to send traps to (Leave empty if targeting!)"

            Button:
                text: "Send Traps"
                size_hint_y: None
                height: '40dp'
                on_release: root.btn_send_traps(trap_send_amount.text)

            Widget:
                # Pushes everything in the right column to the top

    Label:
        text: "Target Players"
        font_size: '16sp'
        bold: True
        size_hint_y: None
        height: '30dp'

    ScrollView:
        size_hint_y: None
        height: '150dp'

        GridLayout:
            id: player_checkbox_grid
            cols: 2
            spacing: 5
            size_hint_y: None
            height: self.minimum_height