                # --- PRIVATE MESSAGE SECTION ---
            Label:
                text: "Private Message"
                font_size: '16sp'
                bold: True
                size_hint_y: None
                height: '30dp'

            BoxLayout:
                orientation: 'horizontal'
                spacing: 20
                size_hint_y: None
                height: '200dp'

                # Players to Message Sub-column
                BoxLayout:
                    orientation: 'vertical'

                    Label:
                        text: "Players to Message"
                        font_size: '16sp'
                        bold: True
                        size_hint_y: None
                        height: '30dp'

                    ScrollView:
                        GridLayout:
                            id: player_pm_checkbox_grid
                            cols: 2
                            spacing: 5
                            size_hint_y: None
                            height: self.minimum_height

                # Games to Message Sub-column
                BoxLayout:
                    orientation: 'vertical'

                    Label:
                        text: "Games to Message"
                        font_size: '16sp'
                        bold: True
                        size_hint_y: None
                        height: '30dp'

                    ScrollView:
                        GridLayout:
                            id: games_pm_checkbox_grid
                            cols: 2
                            spacing: 5
                            size_hint_y: None
                            height: self.minimum_height

            TextInput:
                id: pm_message
                size_hint_y: None
                height: '40dp'
                hint_text: "Enter Message Here"

            Button:
                text: "Send Private Message"
                size_hint_y: None
                height: '40dp'
                on_release: root.btn_private_message(pm_message)